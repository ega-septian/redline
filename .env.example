# Salin ke .env lalu sesuaikan kalau perlu. Semua punya nilai default.
PORT=8787
MAX_REPORT_MB=50
# Detail hasil test lebih tua dari ini dihapus setiap hari (yang dibutuhkan analisis tetap disimpan). 0 = mati.
RETENTION_DAYS=30
# Source run yang boleh mengubah status kelompok bersama: ci (default), local, atau all.
# Run lain tetap disimpan dan dilaporkan, tapi hanya sebagai pratinjau.
STATUS_FROM=ci
# Zona waktu untuk semua waktu di respons API dan log.
TIMEZONE=Asia/Jakarta

# API key server (opsional). Kosong = siapa pun yang bisa menjangkau server boleh memakainya, aman untuk
# server di laptop sendiri. Wajib diisi kalau server bisa dijangkau orang lain; isi juga REDLINE_API_KEY yang
# sama di .env project Playwright. Buat key acak: openssl rand -hex 32
REDLINE_API_KEY=

# Analisis AI (opsional). Kosong = hanya aturan deterministik.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Pencarian kasus mirip dengan embedding Voyage AI (opsional). Kosong = analisis tanpa kasus mirip.
# Buat key di https://dashboard.voyageai.com. 200 juta token pertama gratis.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Kontrak API (OpenAPI 3, JSON) per project Playwright, dipakai AI untuk memutuskan siapa yang menyimpang.
# Format: project=url, dipisah koma. Contoh Toolshop lokal:
# OPENAPI_SPECS=toolshop=http://localhost:8091/docs
OPENAPI_SPECS=

# Database: Neo4j / DozerDB. Jalankan dulu: docker compose up -d
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=redline-local
NEO4J_DATABASE=redline

# ReportPortal (opsional): Redline mengisi jenis defect dan komentar untuk test yang masih "To Investigate".
# Reporter Playwright memicunya kalau dijalankan dengan REPORTPORTAL=1. Kosong = mati.
REPORTPORTAL_URL=
# REPORTPORTAL_URL=http://localhost:8585
REPORTPORTAL_PROJECT=superadmin_personal
REPORTPORTAL_API_KEY=
